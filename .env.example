# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application
# Public base URL of this deployment. Used to build MCP server URLs and OAuth redirect URIs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Secrets
# Signs internal tokens (OAuth state, etc). Generate: openssl rand -hex 32
JWT_SECRET=your_jwt_secret
# Encrypts stored cloud-app credentials at rest. Generate: openssl rand -hex 32
# Falls back to JWT_SECRET if unset. NEVER change this after data is stored.
CREDENTIALS_ENCRYPTION_KEY=your_credentials_encryption_key
